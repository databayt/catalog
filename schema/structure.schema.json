{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "curriculum": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "grade": {
      "type": "string",
      "pattern": "^(kg[1-2]|g([1-9]|1[0-2]))$"
    },
    "subject": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "lang": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "fr"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "outline",
        "authored",
        "official"
      ]
    },
    "concept": {
      "type": "string",
      "enum": [
        "art",
        "life",
        "career",
        "celebration",
        "chemistry",
        "civic",
        "computer",
        "earth",
        "economy",
        "english",
        "geography",
        "health",
        "history",
        "language",
        "skills",
        "math",
        "nature",
        "sport",
        "physics",
        "mind",
        "faith",
        "science",
        "society",
        "teaching"
      ]
    },
    "about": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisites": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "basis": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "standards": {
          "type": "string"
        },
        "standardsBody": {
          "type": "string"
        },
        "examBoard": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "license"
      ],
      "additionalProperties": false
    },
    "textbook": {
      "type": "object",
      "properties": {
        "pageNumbers": {
          "type": "string",
          "enum": [
            "book",
            "pdf"
          ]
        },
        "pageOffset": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "note": {
          "type": "string"
        },
        "coverNote": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "authoredOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "appliedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supersedes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contributors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "object",
            "properties": {
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "concept": {
            "type": "string",
            "enum": [
              "art",
              "life",
              "career",
              "celebration",
              "chemistry",
              "civic",
              "computer",
              "earth",
              "economy",
              "english",
              "geography",
              "health",
              "history",
              "language",
              "skills",
              "math",
              "nature",
              "sport",
              "physics",
              "mind",
              "faith",
              "science",
              "society",
              "teaching"
            ]
          },
          "image": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string"
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lessonsGeneric": {
            "type": "boolean"
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "object",
                  "properties": {
                    "ar": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "image": {
                  "type": "string"
                },
                "concept": {
                  "type": "string",
                  "enum": [
                    "art",
                    "life",
                    "career",
                    "celebration",
                    "chemistry",
                    "civic",
                    "computer",
                    "earth",
                    "economy",
                    "english",
                    "geography",
                    "health",
                    "history",
                    "language",
                    "skills",
                    "math",
                    "nature",
                    "sport",
                    "physics",
                    "mind",
                    "faith",
                    "science",
                    "society",
                    "teaching"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "durationMinutes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "slug",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "title",
          "lessons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "curriculum",
    "grade",
    "subject",
    "title",
    "lang",
    "status",
    "source",
    "contributors",
    "chapters"
  ],
  "additionalProperties": false,
  "$id": "https://cdn.databayt.org/catalog/schema/structure.schema.json",
  "title": "structure"
}
