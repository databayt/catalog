          "type": "mcq",
          "question": "ما محيط مربع طول ضلعه 7 سم؟",
          "options": [
            "28 سم",
            "14 سم",
            "21 سم",
            "49 سم"
          ],
          "answer": "28 سم",
          "explanation": "محيط المربع = 4 × الضلع = 4 × 7 = 28 سم."
