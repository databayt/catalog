          "type": "mcq",
          "question": "'The stars danced' is an example of:",
          "options": [
            "simile",
            "metaphor",
            "personification",
            "alliteration"
          ],
          "answer": "personification",
          "explanation": "Giving human action to stars."
        },
        {
          "id": "g5-eng-unit-02-language-01-figurative-lq02",
          "type": "true_false",
          "question": "A simile uses 'like' or 'as'.",
          "options": [
            "True",
            "False"
          ],
          "answer": true,
          "explanation": "e.g., 'brave as a lion'."
        },
        {
          "id": "g5-eng-unit-02-language-01-figurative-lq03",
          "type": "fill_blank",
          "question": "'Time is a thief' is a ___.",
          "answer": "metaphor",
          "explanation": "Direct comparison without like/as."
        },
        {
          "id": "g5-eng-unit-02-language-01-figurative-lq04",
          "type": "short_answer",
          "question": "Write a simile about the wind.",
          "answer": "e.g., 'The wind was as cold as ice.'",
          "explanation": "Uses like/as."
        },
        {
          "id": "g5-eng-unit-02-language-02-clauses-lq01",
          "type": "mcq",
          "question": "A dependent clause:",
          "options": [
            "stands alone",
            "cannot stand alone",
            "is a single word",
            "has no verb"
          ],
          "answer": "cannot stand alone",
          "explanation": "Needs an independent clause."
        },
        {
          "id": "g5-eng-unit-02-language-02-clauses-lq02",
          "type": "true_false",
          "question": "'because it rained' is a dependent clause.",
          "options": [
            "True",
            "False"
          ],
          "answer": true,
          "explanation": "Incomplete on its own."
        },
        {
          "id": "g5-eng-unit-02-language-02-clauses-lq03",
          "type": "fill_blank",
          "question": "Words like 'and, but, or' are ___.",
