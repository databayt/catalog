          "id": "g6-eng-unit-01-reading-lit-01-theme-lq02",
          "type": "true_false",
          "question": "Theme is usually stated directly in the first line.",
          "options": [
            "True",
            "False"
          ],
          "answer": false,
          "explanation": "Theme is inferred."
        },
        {
          "id": "g6-eng-unit-01-reading-lit-01-theme-lq03",
          "type": "fill_blank",
          "question": "Evidence that supports an idea is called textual ___.",
