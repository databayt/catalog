          "answer": "equal parts in whole",
          "explanation": "Denominator = total equal parts."
        },
        {
          "id": "g3-mat-unit-02-fractions-01-understanding-fractions-lq02",
          "type": "true_false",
          "question": "1/2 is greater than 1/4.",
          "options": [
            "True",
            "False"
          ],
          "answer": true,
          "explanation": "Halves are bigger than quarters."
        },
        {
          "id": "g3-mat-unit-02-fractions-01-understanding-fractions-lq03",
