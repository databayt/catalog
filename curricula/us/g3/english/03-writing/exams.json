          "id": "g3-eng-unit-03-writing-01-opinion-lq03",
          "type": "fill_blank",
          "question": "Words like 'because' introduce a ___.",
          "answer": "reason",
          "explanation": "Reason/justification."
        },
        {
          "id": "g3-eng-unit-03-writing-01-opinion-lq04",
          "type": "short_answer",
          "question": "Write an opinion with one reason.",
          "answer": "e.g., 'Recess is best because we can play.'",
          "explanation": "Opinion + reason."
        },
