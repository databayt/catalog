        {
          "id": "33ab0f01",
          "type": "mcq",
          "question": "ما هي الدالة (التطبيق)؟",
          "options": [
            "علاقة تربط بين مجموعتين",
            "مجموعة من الأعداد",
            "معادلة بسيطة",
            "رسم بياني فقط"
          ],
          "answer": "علاقة تربط بين مجموعتين",
          "explanation": "الدالة هي العلاقة التي تربط كل عنصر من المجال بعنصر واحد فقط في المقابل"
        },
        {
          "id": "8665f018",
          "type": "true_false",
          "question": "مدى التطبيق هو مجموعة جميع الصور الممكنة",
          "answer": true,
          "explanation": "صحيح، المدى يتضمن جميع العناصر المرتبطة في المجموعة الثانية"
        },
        {
          "id": "d55bae3e",
          "type": "fill_blank",
          "question": "التطبيق الذي يرتبط فيه كل عنصر بصورة واحدة فقط يسمى تطبيق ___",
          "answer": "متباين",
          "explanation": "التطبيق المتباين (واحد لواحد) يضمن أن كل صورة تطابق عنصرا واحدا فقط"
        },
        {
          "id": "aaea8ea2",
          "type": "short_answer",
          "question": "اشرح الفرق بين المجال ومدى التطبيق",
          "answer": "المجال هو مجموعة الأولى، والمدى هو مجموعة الصور",
          "explanation": "المجال: مجموعة الإدخال، المدى: مجموعة الإخراج الفعلية"
        },
        {
          "id": "bf0858a3",
          "type": "mcq",
          "question": "أي من التطبيقات التالية يسمى تقابل؟",
          "options": [
            "متباين فقط",
            "شامل فقط",
            "متباين وشامل معا",
            "ليس واحدا منهما"
          ],
          "answer": "متباين وشامل معا",
          "explanation": "التقابل يجب أن يكون متبايناً وشاملاً في نفس الوقت"
        },
        {
          "id": "69215c73",
          "type": "fill_blank",
          "question": "إذا كان f(x) = 2x + 3، فإن f(1) = ___",
          "answer": "5",
          "explanation": "f(1) = 2(1) + 3 = 5"
        },
        {
          "id": "91218a81",
          "type": "mcq",
          "question": "ما هو التمثيل البياني للدالة الخطية؟",
          "options": [
            "منحنى",
            "خط مستقيم",
            "دائرة",
            "قطع مكافئ"
          ],
          "answer": "خط مستقيم",
          "explanation": "الدوال الخطية من الدرجة الأولى تمثل بخطوط مستقيمة"
        },
        {
          "id": "4b1baf19",
          "type": "short_answer",
          "question": "إذا كانت f تطبيق من A إلى B، ما معنى f(a) = b؟",
          "answer": "العنصر a يرتبط بالعنصر b عن طريق f",
          "explanation": "f(a) = b يعني أن صورة a تحت التطبيق f هي b"
        }
